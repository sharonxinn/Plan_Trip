# Amadeus Self-Service API — flights and hotels
# Create an app at https://developers.amadeus.com/
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# Use https://api.amadeus.com after production access is approved.
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Booking.com Demand API — hotels (approved partners only)
BOOKING_API_TOKEN=
BOOKING_AFFILIATE_ID=
BOOKING_BASE_URL=https://demandapi.booking.com/3.2

# Google Calendar (client-side OAuth via Google Identity Services)
# Create an OAuth 2.0 Client ID (type "Web application") at
# https://console.cloud.google.com/apis/credentials — enable the "Google
# Calendar API" first, add http://127.0.0.1:5173 as an authorized JavaScript
# origin, and add your Google account as a test user on the OAuth consent
# screen. Only the Client ID is needed here, never the client secret.
VITE_GOOGLE_CLIENT_ID=

PORT=5173
