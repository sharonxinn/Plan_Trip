{
  "appId": "com.plantrip.ai",
  "appName": "PlanTrip AI",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#020713",
      "showSpinner": true,
      "spinnerColor": "#38bdf8"
    }
  }
}
